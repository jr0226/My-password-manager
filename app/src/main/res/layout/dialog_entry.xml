<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New Vault Entry"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2D3748"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F4F8">

            <ImageView
                android:id="@+id/ivDialogLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/btnChangeLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to change logo"
            android:textSize="12sp"
            android:textColor="#3182CE"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etDialogSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Website / App Name"
        android:background="@drawable/rounded_input"
        android:layout_marginBottom="12dp" />

    <Spinner
        android:id="@+id/spinnerDialogCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/rounded_input"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDialogUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username / Email"
        android:background="@drawable/rounded_input"
        android:layout_marginBottom="12dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etDialogPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="@drawable/rounded_input"
            android:paddingEnd="56dp" />

        <TextView
            android:id="@+id/btnDialogTogglePass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="SHOW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#3182CE"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <EditText
        android:id="@+id/etDialogNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes (Optional)"
        android:background="@drawable/rounded_input"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnDialogSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Entry"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button"/>
</LinearLayout>
